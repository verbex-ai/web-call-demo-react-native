{
  "expo": {
    "name": "BL Voice Demo",
    "slug": "web-call-demo-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "verbexcall",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0908",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.verbex.callnative",
      "bitcode": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Verbex Test Call needs your microphone so you can talk to the voice agent.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "ai.verbex.callnative",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "expo-router",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Verbex Test Call needs your microphone so you can talk to the voice agent."
        }
      ],
      "expo-sharing"
    ]
  }
}
